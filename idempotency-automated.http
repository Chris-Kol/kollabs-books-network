# Automated Idempotency Tests with Assertions
@baseUrl = http://localhost:8000
@testId = bbbbbbbb-cccc-4ddd-8eee-ffffffffffff

### Cleanup
DELETE {{baseUrl}}/books/{{testId}}

### ========================================
### 1. GET Idempotency Test
### ========================================
GET {{baseUrl}}/books
Accept: application/json

> {%
client.global.set("firstGetResponse", JSON.stringify(response.body));
client.test("First GET should succeed", function() {
    client.assert(response.status === 200, "Expected status 200");
});
%}

###
GET {{baseUrl}}/books
Accept: application/json

> {%
client.test("GET is idempotent", function() {
    const firstResponse = client.global.get("firstGetResponse");
    const secondResponse = JSON.stringify(response.body);
    client.assert(firstResponse === secondResponse, "GET responses should be identical");
    client.assert(response.status === 200, "Second GET should also return 200");
});
%}

### ========================================
### 2. POST Non-Idempotency Test (Expected)
### ========================================
POST {{baseUrl}}/books
Content-Type: application/json

{
  "id": "{{testId}}",
  "title": "Idempotency Test Book",
  "author": "Test Author",
  "price": 29.99,
  "currency": "EUR",
  "stock": 5
}

> {%
client.test("First POST should create", function() {
    client.assert(response.status === 201, "Expected status 201 for creation");
    client.assert(response.body.id === "bbbbbbbb-cccc-4ddd-8eee-ffffffffffff", "Should return created book");
});
%}

###
POST {{baseUrl}}/books
Content-Type: application/json

{
  "id": "{{testId}}",
  "title": "Idempotency Test Book",
  "author": "Test Author",
  "price": 29.99,
  "currency": "EUR",
  "stock": 5
}

> {%
client.test("POST is correctly non-idempotent", function() {
    client.assert(response.status === 409, "Expected status 409 for duplicate");
    client.assert(response.body.error.includes("already exists"), "Should return conflict error");
});
%}

### ========================================
### 3. PUT Idempotency Test
### ========================================
PUT {{baseUrl}}/books/{{testId}}
Content-Type: application/json

{
  "title": "Updated Idempotency Test",
  "author": "Updated Author",
  "price": 35.99,
  "currency": "USD",
  "stock": 10
}

> {%
client.global.set("firstPutResponse", JSON.stringify(response.body));
client.test("First PUT should succeed", function() {
    client.assert(response.status === 200, "Expected status 200");
    client.assert(response.body.title === "Updated Idempotency Test", "Should update title");
});
%}

###
PUT {{baseUrl}}/books/{{testId}}
Content-Type: application/json

{
  "title": "Updated Idempotency Test",
  "author": "Updated Author",
  "price": 35.99,
  "currency": "USD",
  "stock": 10
}

> {%
client.test("PUT is idempotent", function() {
    const firstResponse = client.global.get("firstPutResponse");
    const secondResponse = JSON.stringify(response.body);
    client.assert(response.status === 200, "Second PUT should return 200");
    client.assert(firstResponse === secondResponse, "PUT responses should be identical");
});
%}

### ========================================
### 4. DELETE Idempotency Test  
### ========================================
DELETE {{baseUrl}}/books/{{testId}}

> {%
client.test("First DELETE should succeed", function() {
    client.assert(response.status === 200, "Expected status 200 for successful deletion");
    client.assert(response.body.message.includes("deleted"), "Should return deletion confirmation");
});
%}

###
DELETE {{baseUrl}}/books/{{testId}}

> {%
client.test("DELETE is idempotent", function() {
    client.assert(response.status === 404, "Second DELETE should return 404 (idempotent end state)");
    client.assert(response.body.error === "Book not found", "Should return not found error");
});
%}

### ========================================
### 5. Verify Resource is Gone (Idempotency Confirmation)
### ========================================
GET {{baseUrl}}/books/{{testId}}
Accept: application/json

> {%
client.test("Resource should be permanently deleted", function() {
    client.assert(response.status === 404, "GET should confirm resource doesn't exist");
    client.assert(response.body.error === "Book not found", "Should return not found error");
});
%}